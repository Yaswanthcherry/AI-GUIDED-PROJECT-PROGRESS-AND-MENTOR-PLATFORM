# =====================================================================
# AI-Guided Project Progress Tracking Platform — backend configuration.
# Copy to .env and fill in. Never commit .env
# (docker-compose users: the root .env.example covers everything)
# =====================================================================

# PostgreSQL connection string (SQLite works for local dev/testing:
# DATABASE_URL=sqlite:///./aapm_dev.db)
DATABASE_URL=postgresql://aapm:aapm@localhost:5432/aapm

# JWT signing secret — generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# (SECRET_KEY is also accepted)
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins allowed by CORS (your frontend origins)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Seed demo accounts (student@campus.edu / faculty@campus.edu, demo1234)
# plus a sample project on startup. Keep false in production.
DEMO_MODE=false

# LLM provider: auto | openai | huggingface | offline
#   auto    -> OpenAI if OPENAI_API_KEY set, else Hugging Face if key set, else offline
#   offline -> deterministic agent composer (no external calls; fully local)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2200
