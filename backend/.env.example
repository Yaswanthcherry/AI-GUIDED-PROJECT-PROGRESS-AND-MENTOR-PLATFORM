# =====================================================================
# AI-Guided Project Progress Tracking Platform — backend configuration.
# Copy to .env and fill in. Never commit .env
# =====================================================================

# PostgreSQL connection string (SQLite works for local dev/testing:
# DATABASE_URL=sqlite:///./aapm_dev.db)
DATABASE_URL=postgresql://aapm:aapm@localhost:5432/aapm

# JWT signing secret — generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins allowed by CORS (your existing frontend dev servers)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# LLM provider: auto | openai | huggingface | offline
#   auto    -> OpenAI if OPENAI_API_KEY set, else Hugging Face if key set, else offline
#   offline -> deterministic agent composer (no external calls; fully local)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2200
