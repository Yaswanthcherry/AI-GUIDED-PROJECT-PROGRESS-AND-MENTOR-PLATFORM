# =====================================================================
# AI-Guided Project Progress Tracking Platform — root environment
# Used by docker-compose. Copy to .env and adjust. Never commit .env.
# AI keys and DB credentials are consumed ONLY by the backend container —
# the frontend bundle never receives them (it only gets VITE_API_BASE_URL).
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=aapm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aapm
# Host `db` = the compose service. For non-Docker runs use localhost.
DATABASE_URL=postgresql://aapm:change-me-strong-db-password@db:5432/aapm

# ---------- Backend ----------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-long-random-secret
DEMO_MODE=true            # seeds student@campus.edu / faculty@campus.edu (demo1234) + sample project
LLM_PROVIDER=auto         # auto | openai | huggingface | offline
OPENAI_API_KEY=           # optional — enables real LLM agents
HF_API_KEY=               # optional — Hugging Face fallback provider
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ---------- Frontend (build-time only) ----------
# /api -> same-origin via nginx proxy (recommended, works with any domain)
# or an absolute origin, e.g. https://api.yourdomain.com (backend CORS must include your app origin)
VITE_API_BASE_URL=/api
